<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<UseSkiaSharp>false</UseSkiaSharp>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- App é WPF, só roda no Windows. Sem fixar a plataforma, os pacotes
		     nativos (Magick, pdfium, SQLite) copiam para a saída os binários de
		     Linux, musl e macOS também: 166 MB de runtimes que nunca são usados.
		     O Append=false mantém o exe em bin/<cfg>/net8.0-windows, sem a pasta
		     win-x64 no meio do caminho. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="app.ico" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Docnet.Core" Version="2.6.0" />
	  <PackageReference Include="Magick.NET-Q8-x64" Version="15.1.1" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
	</ItemGroup>

</Project>