<Window x:Class="MangaManager.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apoiadores — AnimeUnited" Height="560" Width="820"
        WindowStartupLocation="CenterOwner" Background="#1A1A1A">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Quem tem acesso a mangas.animeunited.com.br"
                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtResumo" Margin="12,0,0,0" Foreground="#888888"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Lista -->
        <DataGrid x:Name="GridUsuarios" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#141414" Foreground="#DDDDDD" BorderBrush="#2A2A2A"
                  RowBackground="#1A1A1A" AlternatingRowBackground="#161616"
                  HorizontalGridLinesBrush="#262626" SelectionMode="Single"
                  SelectionChanged="Grid_SelectionChanged" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome"  Binding="{Binding Name}"  Width="2*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="3*"/>
                <DataGridTextColumn Header="Acesso" Binding="{Binding AccessLevel}" Width="110"/>
                <DataGridTextColumn Header="Desde" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Formulário -->
        <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome" Foreground="#888888" Margin="0,0,8,3"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Email" Foreground="#888888" Margin="0,0,8,3"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Nível de acesso" Foreground="#888888" Margin="0,0,0,3"/>

            <TextBox  x:Name="TxtNome"  Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"/>
            <TextBox  x:Name="TxtEmail" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"/>
            <ComboBox x:Name="CboNivel" Grid.Row="1" Grid.Column="2">
                <ComboBoxItem Content="none"/>
                <ComboBoxItem Content="supporter" IsSelected="True"/>
                <ComboBoxItem Content="admin"/>
            </ComboBox>
        </Grid>

        <!-- Ações -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="BtnNovo"     Content="Limpar campos" Click="BtnNovo_Click"/>
            <Button x:Name="BtnSalvar"   Content="Salvar"        Click="BtnSalvar_Click"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="BtnRemover"  Content="Remover"       Click="BtnRemover_Click"
                    Background="#C0392B" Foreground="White"/>
            <Button x:Name="BtnAtualizar" Content="Recarregar"   Click="BtnAtualizar_Click"/>
            <TextBlock x:Name="TxtStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="#888888" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
