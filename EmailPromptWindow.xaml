<Window x:Class="MangaManager.EmailPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnitedCast" Height="170" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock Text="Digite o email cadastrado como apoiador UnitedCast:"
                   Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="EmailBox" Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                 Padding="6,4" FontSize="12" KeyDown="EmailBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Width="80" Height="26" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Height="26" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
